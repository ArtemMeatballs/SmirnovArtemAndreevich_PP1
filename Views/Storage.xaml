<Page x:Class="WoodAccountingSystem.Views.Storage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WoodAccountingSystem.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Storage">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80*"></RowDefinition>
            <RowDefinition Height="20*"></RowDefinition>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" x:Name="SPinfoStorage">
            <TextBlock FontSize="24" Margin="0 0 0 15" x:Name="TBstorageNumber"></TextBlock>
            <TextBlock FontSize="18" x:Name="TBstorageVolume"></TextBlock>
            <TextBlock FontSize="18" Margin="0 0 0 15" x:Name="TBstorageFree"></TextBlock>
            <TextBlock Text="Склад пуст" FontSize="21" HorizontalAlignment="Center" Margin="0 30 0 0" x:Name="TBwoodNotFound"></TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">

            <Button Grid.Column="0" Content="Назад" FontSize="18" Width="150" Height="40" Margin="0 0 15 0" Click="Click_btn_back"></Button>
            <Button Grid.Column="1" Content="Загрузить" FontSize="18" Width="150" Height="40" Margin="0 0 15 0" Click="Click_btn_add"></Button>
            <Button Grid.Column="2" Content="Выгрузить" FontSize="18" Width="150" Height="40" Click="Click_btn_sub"></Button>
            
        </StackPanel>
        
    </Grid>
</Page>
