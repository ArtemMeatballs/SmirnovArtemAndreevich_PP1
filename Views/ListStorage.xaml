<Page x:Class="WoodAccountingSystem.Views.ListStorage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WoodAccountingSystem.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListStorage">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" x:Name="SPlistStorage">
            <TextBlock Text="Складов не найдено" FontSize="20" HorizontalAlignment="Center" Margin="0 15 0 0" x:Name="TBstorageNotFound"></TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 35 0 0">

            <Button Grid.Column="0" Content="Удалить" Width="200" Height="45" FontSize="20" Margin="0 0 20 0" Click="Click_btn_delete"></Button>
            <Button Grid.Column="1" Content="Добавить"  Width="200" Height="45" FontSize="20" Click="Click_btn_add"></Button>

        </StackPanel>

    </Grid>
</Page>
